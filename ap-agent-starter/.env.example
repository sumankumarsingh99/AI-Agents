APP_ENV=development
DATABASE_URL=sqlite:///./ap_agent.db
# Mandatory safe default. This code refuses to start if set to anything other than mock.
PAYMENT_MODE=mock
# Local demo configuration only; never commit real secrets.
APP_SECRET=replace-with-a-long-random-secret
AUTONOMOUS_SPEND_LIMIT=500.00
# Optional shared secret for agent-to-agent intake. Leave blank to keep that endpoint disabled.
AGENT_API_TOKEN=

# Optional AI invoice extraction. Without a key, regex extraction is used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Image/scanned-PDF OCR requires the Tesseract application installed on Windows.
# Optional path if Tesseract is not on PATH, e.g. C:\\Program Files\\Tesseract-OCR\\tesseract.exe
TESSERACT_CMD=
